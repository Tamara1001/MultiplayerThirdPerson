/*
    KillFeedUI.uss
    ════════════════════════════════════════════════════════════════════════════
    Stylesheet for the FFA Kill Feed HUD panel.

    Follows the template's design language (dark semi-transparent backgrounds,
    white/light-grey text, subtle rounded corners, opacity transitions) as
    established in CoreHUD.uss and WeaponHUD.uss.

    Class inventory
    ───────────────
      .kill-feed-container      → outer container, left-side anchored
      .kill-feed-entry          → a single kill row (horizontal flex)
      .kill-feed-entry--self    → modifier for self-elimination rows (muted style)
      .kill-feed-entry--fade-out → triggers the CSS opacity transition to 0
      .kill-feed-killer         → killer name label
      .kill-feed-killer--local  → modifier: local player is the killer (gold tint)
      .kill-feed-separator      → the ✕ / ☠ icon between names
      .kill-feed-victim         → victim name label
      .kill-feed-victim--local  → modifier: local player is the victim (red tint)
*/

/* ── Container ─────────────────────────────────────────────────────────────── */

.kill-feed-container {
    position: absolute;
    left: 20px;
    top: 80px;          /* below the match timer if present, above the health bars */
    min-width: 260px;
    max-width: 420px;
    flex-direction: column;
    align-items: flex-start;
}

/* ── Individual Entry Row ───────────────────────────────────────────────────── */

.kill-feed-entry {
    flex-direction: row;
    align-items: center;
    background-color: rgba(12, 12, 14, 0.82);
    border-radius: 6px;
    padding: 6px 10px;
    margin-bottom: 5px;

    /* Slide-in from the left */
    translate: 0 0;

    /* Fade animation targets */
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

/* Self-elimination variant: slightly muted appearance */
.kill-feed-entry--self {
    background-color: rgba(40, 30, 10, 0.82);
}

/* Triggered by KillFeedUI.cs when the entry expires */
.kill-feed-entry--fade-out {
    opacity: 0;
}

/* ── Killer Name ────────────────────────────────────────────────────────────── */

.kill-feed-killer {
    color: rgb(220, 220, 220);
    font-size: 12px;
    -unity-font-style: bold;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 160px;
}

/* Highlight when the LOCAL player scored the kill */
.kill-feed-killer--local {
    color: rgb(255, 210, 50);    /* gold */
    -unity-font-style: bold;
}

/* ── Separator Icon ─────────────────────────────────────────────────────────── */

.kill-feed-separator {
    color: rgb(180, 60, 60);
    font-size: 10px;
    margin-left: 6px;
    margin-right: 6px;
    flex-shrink: 0;
}

/* ── Victim Name ────────────────────────────────────────────────────────────── */

.kill-feed-victim {
    color: rgb(160, 160, 160);
    font-size: 12px;
    -unity-font-style: normal;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 160px;
}

/* Highlight when the LOCAL player was eliminated */
.kill-feed-victim--local {
    color: rgb(220, 80, 80);     /* red */
    -unity-font-style: bold;
}
