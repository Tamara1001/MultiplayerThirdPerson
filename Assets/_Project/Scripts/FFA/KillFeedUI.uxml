<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Core/Scripts/Runtime/Framework/HUD/CoreHUD.uss?fileID=7433441132597879392&amp;guid=e44b6512441c14caeb7f0f5c564b261c&amp;type=3#CoreHUD"/>
    <Style src="project://database/Assets/_Project/Scripts/FFA/KillFeedUI.uss?fileID=7433441132597879392&amp;guid=2f69d529bf862564c8bd663aece6ea26&amp;type=3#KillFeedUI"/>
    <ui:VisualElement name="hud-root">
        <ui:VisualElement name="reticle-container">
            <ui:VisualElement name="player-reticle"/>
        </ui:VisualElement>
        <ui:VisualElement name="message-overlay" style="display: none;">
            <ui:Label name="message-label" text="RESPAWNING IN"/>
            <ui:VisualElement name="message-divider"/>
            <ui:Label name="countdown-label" text="5"/>
        </ui:VisualElement>
        <ui:VisualElement name="match-info-container">
            <ui:Label name="match-timer-label" text="05:00"/>
        </ui:VisualElement>
        <ui:VisualElement name="notification-container" class="notification-container"/>
        <ui:VisualElement name="kill-feed-container" class="kill-feed-container"/>
        <ui:VisualElement name="health-info-container">
            <ui:ProgressBar name="player-health-bar" low-value="0" high-value="100" value="100" class="blocks-progress-bar"/>
            <ui:ProgressBar name="player-stamina-bar" low-value="0" high-value="100" value="100" class="blocks-progress-bar"/>
        </ui:VisualElement>
        <ui:VisualElement name="kill-count-container" style="bottom: 350px;">
            <ui:Label name="kill-count-label" text="KILLS : 0"/>
        </ui:VisualElement>
        <ui:VisualElement name="weapon-info-container">
            <ui:Label name="weapon-type-label" text="Weapon Name"/>
            <ui:Image name="weapon-icon"/>
            <ui:VisualElement name="ammo-container">
                <ui:Label name="ammo-label" text="0 / 0"/>
                <ui:ProgressBar value="100" name="player-ammo-bar" class="blocks-progress-bar blocks-ammo-bar"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
