<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:ui="UnityEngine.UIElements"
         editor-extension-mode="False">

    <!--
        KillFeedUI.uxml
        ════════════════════════════════════════════════════════════════════════
        Template for the FFA Kill Feed HUD panel.

        Usage
        ─────
        Assign this file as the "Source Asset" on the UIDocument component of
        your Kill Feed UI GameObject (or the existing Shooter HUD GameObject if
        using Option B from the KillFeedUI setup comments).

        Elements expected by KillFeedUI.cs
        ────────────────────────────────────
          • "kill-feed-container"  → root for all kill entries (built at runtime)

        Elements expected by CoreHUD (base class)
        ──────────────────────────────────────────
          • "player-health-bar"       → ProgressBar
          • "player-stamina-bar"      → ProgressBar
          • "notification-container"  → VisualElement (elimination messages)
          • "message-overlay"         → VisualElement (respawn countdown overlay)
          • "message-label"           → Label
          • "message-divider"         → VisualElement
          • "countdown-label"         → Label

        NOTE: If you are using this as a STANDALONE UIDocument (Option A), you
        can remove the CoreHUD elements below and set Sort Order > 1 so it
        renders on top of the existing HUD. In that case KillFeedUI only needs
        the "kill-feed-container" element and you must handle CoreHUD separately.
    -->

    <!-- Shared stylesheet: CoreHUD base styles (notification-item, message-overlay, etc.) -->
    <Style src="project://database/Assets/Core/Scripts/Runtime/Framework/HUD/CoreHUD.uss"/>
    <!-- Kill Feed specific styles -->
    <Style src="project://database/Assets/_Project/Scripts/FFA/KillFeedUI.uss"/>

    <ui:VisualElement name="hud-root">

        <!-- ── BOTTOM-LEFT: Health / Stamina bars (required by CoreHUD) ─────── -->
        <ui:VisualElement name="health-info-container">
            <ui:ProgressBar name="player-health-bar"
                            low-value="0" high-value="100" value="100"
                            class="blocks-progress-bar"/>
            <ui:ProgressBar name="player-stamina-bar"
                            low-value="0" high-value="100" value="100"
                            class="blocks-progress-bar"/>
        </ui:VisualElement>

        <!-- ── TOP-RIGHT: Existing elimination notifications (CoreHUD) ────────── -->
        <ui:VisualElement name="notification-container" class="notification-container"/>

        <!-- ── LEFT-SIDE: FFA Kill Feed panel ──────────────────────────────────
             KillFeedUI.cs appends/removes kill-feed-entry elements here at runtime.
             The USS positions this container on the left, below the top edge.
        ─────────────────────────────────────────────────────────────────────── -->
        <ui:VisualElement name="kill-feed-container" class="kill-feed-container"/>

        <!-- ── TOP-CENTER: Match Timer ────────────────────────────────────────── -->
        <ui:VisualElement name="match-info-container" style="position: absolute; top: 10px; width: 100%; align-items: center; pointer-events: none;">
            <ui:Label name="match-timer-label" text="05:00" style="font-size: 32px; -unity-font-style: bold; color: white; -unity-text-outline-width: 1px; -unity-text-outline-color: black;" />
        </ui:VisualElement>

        <!-- ── BOTTOM-RIGHT: Kill Count ──────────────────────────────────────── -->
        <ui:VisualElement name="kill-count-container" style="position: absolute; bottom: 20px; right: 20px; align-items: flex-end; pointer-events: none;">
            <ui:Label name="kill-count-label" text="KILLS : 0" style="font-size: 24px; -unity-font-style: bold; color: white; -unity-text-outline-width: 1px; -unity-text-outline-color: black;" />
        </ui:VisualElement>

        <!-- ── CENTRE: Respawn countdown overlay (required by CoreHUD) ─────────── -->
        <ui:VisualElement name="message-overlay" style="display: none;">
            <ui:Label name="message-label" text="RESPAWNING IN"/>
            <ui:VisualElement name="message-divider"/>
            <ui:Label name="countdown-label" text="5"/>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
